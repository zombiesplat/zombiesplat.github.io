const skills = {
  leadership: ["People Management", "Mentoring", "Agile & SAFe", "Technical Roadmapping", "Stakeholder Alignment", "Budget Management", "Incident Management"],
  languages: ["PHP", "JavaScript", "TypeScript", "Python", "Ruby", "SQL"],
  frameworks: ["Laravel", "Symfony", "React", "Vue", "Next.js", "Node.js"],
  cloud: ["AWS (EC2, S3, Lambda, RDS, SQS, Glue)", "CI/CD (GitHub Actions, Jenkins)", "Docker"],
