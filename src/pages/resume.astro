];
---

<MarketingLayout title={title} description={description}>
  <div class="relative overflow-hidden bg-background pt-24 pb-16 sm:pt-32 sm:pb-24">
    <!-- Background Decoration -->
    <div class="absolute top-0 left-1/2 -z-10 h-[1000px] w-[1000px] -translate-x-1/2 [mask-image:radial-gradient(closest-side,white,transparent)] sm:left-full sm:-ml-80 lg:left-1/2 lg:ml-0 lg:-translate-x-1/2 lg:translate-y-[-10%]">
      <div class="aspect-[1097/1023] w-[68.5625rem] bg-linear-to-tr from-primary/20 to-accent/20 opacity-20"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center gap-8 mb-16">
        <div class="relative group">
          <div class="absolute -inset-1 bg-linear-to-r from-primary to-accent rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
          <div class="relative h-32 w-32 rounded-full overflow-hidden border-2 border-primary/20 bg-surface">
            <!-- Suggested Headshot: A professional portrait in tech-casual attire -->
            <img 
              src="/images/logos/logo_square.svg" 
              alt="Alan Asher" 
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <div class="text-center md:text-left">
          <h1 class="text-4xl font-bold tracking-tight text-text sm:text-6xl">Alan Asher</h1>
          <p class="mt-2 text-xl font-semibold bg-linear-to-r from-primary to-accent bg-clip-text text-transparent">
            Senior Engineering Leader & Full Stack Architect
          </p>
          <div class="mt-4 flex flex-wrap justify-center md:justify-start gap-4 text-text-muted">
            <span class="flex items-center gap-1.5"><Icon name="lucide:mail" class="w-4 h-4" /> <Deobfuscator client:load text="nyna@nfgrevfxcbhaq.pbz" type="email" className="resume-email pii" /></span>
            <span class="flex items-center gap-1.5"><Icon name="lucide:phone" class="w-4 h-4" /> <Deobfuscator client:load text="157.122.7864" type="phone" className="resume-phone pii" /></span>
            <span class="flex items-center gap-1.5"><Icon name="lucide:map-pin" class="w-4 h-4" /> Kentucky, USA</span>
            <span class="flex items-center gap-1.5"><Icon name="simple-icons:linkedin" class="w-4 h-4" /> <Deobfuscator client:load text="/va/gurmbzovrfcyng" type="link" hrefPrefix="https://linkedin.com" className="resume-linkedin pii" /></span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Sidebar -->
        <div class="space-y-12">
          <!-- Summary -->
          <section>
            <h2 class="text-xl font-bold text-text mb-4 border-b border-border pb-2">Summary</h2>
            <p class="text-text-muted leading-relaxed">
              Senior engineering leader with 19+ years of experience building and scaling SaaS platforms in healthcare, logistics, and gentech. 
              Proven track record of growing high-performing teams, accelerating delivery, and driving multimillion-dollar product outcomes.
            </p>
          </section>

          <!-- Skills -->
          <section>
            <h2 class="text-xl font-bold text-text mb-6 border-b border-border pb-2">Technical Skills</h2>
            <div class="space-y-6">
              <div>
                <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-3">Leadership</h3>
                <div class="flex flex-wrap gap-2">
                  {skills.leadership.map(skill => (
                    <span class="px-3 py-1 bg-surface border border-border rounded-full text-sm text-text-muted">{skill}</span>
                  ))}
                </div>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-3">Languages</h3>
                <div class="flex flex-wrap gap-2">
                  {skills.languages.map(skill => (
                    <span class="px-3 py-1 bg-primary/5 border border-primary/10 rounded-full text-sm text-primary font-medium">{skill}</span>
                  ))}
                </div>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-3">Frameworks</h3>
                <div class="flex flex-wrap gap-2">
                  {skills.frameworks.map(skill => (
                    <span class="px-3 py-1 bg-accent/5 border border-accent/10 rounded-full text-sm text-accent font-medium">{skill}</span>
                  ))}
                </div>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-3">Cloud & DevOps</h3>
                <div class="flex flex-wrap gap-2">
                  {skills.cloud.map(skill => (
                    <span class="px-3 py-1 bg-surface border border-border rounded-full text-sm text-text-muted">{skill}</span>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <!-- Education -->
          <section>
            <h2 class="text-xl font-bold text-text mb-4 border-b border-border pb-2">Education</h2>
            <div class="space-y-4">
              {education.map(edu => (
                <div>
                  <h3 class="font-semibold text-text">{edu.degree}</h3>
                  <p class="text-sm text-text-muted">{edu.school}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-12">
          <section>
            <div class="flex items-center justify-between mb-8 border-b border-border pb-2">
              <h2 class="text-2xl font-bold text-text">Professional Experience</h2>
              <div class="flex gap-2">
                 <!-- Modern badge for role toggle or highlighting -->
                 <!--<span class="px-3 py-1 bg-primary text-white text-xs font-bold rounded-sm uppercase tracking-tighter">Managerial</span>-->
                 <!--<span class="px-3 py-1 bg-accent text-white text-xs font-bold rounded-sm uppercase tracking-tighter">Technical</span>-->
              </div>
            </div>

            <div class="space-y-12">
              {experience.map(job => (
                <div class="relative pl-8 before:absolute before:left-0 before:top-2 before:bottom-0 before:w-px before:bg-border">
                  <div class="absolute left-[-4px] top-2 h-2 w-2 rounded-full bg-primary border-4 border-background ring-1 ring-primary"></div>
                  
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-4">
                    <h3 class="text-xl font-bold text-text">{job.role}</h3>
                    <span class="text-sm font-medium text-text-muted whitespace-nowrap">{job.period}</span>
                  </div>
                  
                  <div class="flex items-center gap-2 mb-4 text-primary font-medium">
                    <Icon name="lucide:building-2" class="w-4 h-4" />
                    <span>{job.company}</span>
                    <span class="text-border">|</span>
                    <span class="text-text-muted text-sm font-normal">{job.location}</span>
                  </div>

                  <ul class="space-y-3">
                    {job.achievements.map(achievement => (
                      <li class="flex items-start gap-3 text-text-muted leading-relaxed">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/60"></span>
                        {achievement}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</MarketingLayout>
